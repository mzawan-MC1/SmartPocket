{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.smartpocket.desktop",
  "app": {
    "windows": [
      {
        "label": "main",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) SmartPocketStore/1.0 Tauri/2"
      }
    ],
    "security": {
      "freezePrototype": false,
      "capabilities": [
        "no-ipc"
      ]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
