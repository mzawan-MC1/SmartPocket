{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Smart Pocket",
  "mainBinaryName": "SmartPocket",
  "version": "../package.json",
  "identifier": "com.smartpocket.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4028/sign-up-login?desktop=1",
    "frontendDist": "https://1smartpocket.com/sign-up-login?desktop=1"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Smart Pocket",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) SmartPocketDesktop/1.0 Tauri/2",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "focus": true,
        "devtools": false
      }
    ],
    "security": {
      "freezePrototype": false,
      "pattern": {
        "use": "brownfield"
      },
      "capabilities": [
        "no-ipc"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "homepage": "https://1smartpocket.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Smart Pocket",
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "smartpocket"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/mzawan-MC1/SmartPocket/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQzc2NkJGRTVBMzhBMTMKUldRVGlxUGx2MmJIZ3ZtYmp1MVM2WTlZTVN5ZENWd2tWU21MeU1xVXM4UTNLT0xjb01HcGtBS0UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
